# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust values as needed for local development.
# Do NOT commit your real `.env` file or real secrets to version control.
# ---------------------------------------------------------------------------

# PostgreSQL (shared by both Django services)
POSTGRES_DB=exam_results
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-this-secret-key
DEBUG=True

# Cross-service links (Docker Compose service names / host ports)
STUDENT_PORTAL_URL=http://localhost:8000
ADMIN_PORTAL_URL=http://localhost:8001

# Default admin account, auto-created on Admin Management Service startup.
# See README.md "Local Development Credentials" for details.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_EMAIL=admin@example.com
